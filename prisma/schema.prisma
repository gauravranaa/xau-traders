generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Blog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String   @unique
  content   String
  createdAt DateTime @default(now())
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name     String?
  email    String  @unique
  password String

  role String @default("student") // student | admin

  // Enrollment Control
  approved Boolean @default(false)
  batch    String? // Online | Offline

  enrolledAt       DateTime? // When admin approves
  expiresAt        DateTime? // Access end date
  resetToken       String?
  resetTokenExpiry DateTime?
  // Optional future features
  status           String    @default("pending") // pending | active | expired | revoked

  createdAt DateTime @default(now())

  enrollments     CourseEnrollment[] @relation("UserEnrollments")
  videoProgresses VideoProgress[]
}

model Course {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  price       String
  thumbnail   String?
  type        String   @default("online")
  whatsapp    String?
  createdAt   DateTime @default(now())

  videos             Video[]             @relation("CourseVideos")
  enrollments        CourseEnrollment[]  @relation("CourseEnrollments")
  enrollmentRequests EnrollmentRequest[]
}

model Video {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  title String
  url   String

  courseId String @db.ObjectId
  course   Course @relation("CourseVideos", fields: [courseId], references: [id], onDelete: Cascade)

  videoProgresses VideoProgress[]
}



model CourseEnrollment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId   String @db.ObjectId
  courseId String @db.ObjectId

  user   User   @relation("UserEnrollments", fields: [userId], references: [id])
  course Course @relation("CourseEnrollments", fields: [courseId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}
model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String
  courseId  String?
  type      String?
  createdAt DateTime @default(now())
}
model EnrollmentRequest {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  email String
  phone String

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id])

  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
}

model VideoProgress {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  userId  String  @db.ObjectId
  videoId String  @db.ObjectId
  watched Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id])
  video Video @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model Certificate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  imageUrl  String // Cloudinary / ImageKit / public URL
  issuedBy  String // e.g. Funded Firm name
  createdAt DateTime @default(now())
}
